{
  "name": "project-traceability-suite",
  "version": "1.3.0",
  "description": "Professional industrial project traceability and dashboard suite for real-time production monitoring.",
  "main": "main.js",
  "scripts": {
    "dev": "set NODE_ENV=development&& electron .",
    "start": "electron .",
    "dist": "electron-builder",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "build": {
    "appId": "com.traceability.suite",
    "productName": "Project Traceability Suite",
    "directories": {
      "output": "../dist-exe/v${version}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico",
      "artifactName": "${productName}-Setup.${ext}"
    },
    "afterPack": "after-pack.js",
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "installer_icon.ico",
      "uninstallerIcon": "installer_icon.ico"
    },
    "files": [
      "main.js",
      "preload.js",
      "splash.html",
      "after-pack.js",
      "icon.ico",
      "icon.png",
      "installer_icon.ico",
      "Meet_Mistry_cert.pfx",
      "server/**/*",
      "dist/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**/*"
    ]
  },
  "keywords": [],
  "author": "Meet Mistry",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^41.1.1",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "body-parser": "^2.2.2",
    "cors": "^2.8.6",
    "electron-context-menu": "^4.1.2",
    "electron-serve": "^2.0.0",
    "electron-store": "^11.0.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "fs-extra": "^8.1.0",
    "node-cron": "^4.2.1",
    "xlsx": "^0.18.5"
  }
}
